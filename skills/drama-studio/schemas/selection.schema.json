{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "drama-studio/selection/v0",
  "title": "宿主交给 context-pack 的选材清单（语义选材由模型完成，工具只做确定性组装）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": "drama-studio/selection/v0"
    },
    "sourceSnapshotId": {
      "type": [
        "string",
        "null"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "partition",
          "required",
          "reason"
        ],
        "properties": {
          "ref": {
            "$ref": "#/$defs/ref"
          },
          "partition": {
            "type": "string",
            "enum": [
              "project_facts",
              "current_plan",
              "knowledge",
              "unknowns",
              "samples"
            ],
            "description": "task 分区由工具按 --task 自动填入，不能出现在选材清单"
          },
          "required": {
            "type": "boolean"
          },
          "usage": {
            "type": "string",
            "enum": [
              "project_text",
              "creative_reference",
              "comparison_only",
              "evaluation_only"
            ],
            "description": "缓存条目默认 project_text；知识卡一律取卡片自身 usage，写了不同值即输入错误"
          },
          "chars": {
            "type": "integer",
            "minimum": 0,
            "description": "宿主估算值，工具忽略，以实际截取文本为准"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Honest unknowns that no other field can express"
    },
    "role": {
      "type": "string",
      "enum": [
        "author",
        "reader_effect",
        "dialogue_author",
        "dialogue_read",
        "fact_check",
        "similarity_review",
        "evaluation",
        "function_mapper",
        "ledger_keeper",
        "season_planner",
        "dialogue_designer",
        "situation_checker",
        "cold_reader"
      ],
      "description": "Optional: the role this selection is for; cold_reader allows one project_facts item only"
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "revision"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "remote_artifact",
            "remote_page",
            "remote_snapshot",
            "remote_brief",
            "local_file",
            "knowledge_card",
            "context_snapshot",
            "remote_receipt"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "range": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
