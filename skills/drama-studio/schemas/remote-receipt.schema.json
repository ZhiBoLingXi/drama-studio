{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "drama-studio/remote-receipt/v0",
  "title": "mali-story 调用意图与实际结果",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operation",
    "requestId",
    "inputFingerprint",
    "remote",
    "outcome",
    "observedAt",
    "evidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": "drama-studio/remote-receipt/v0"
    },
    "operation": {
      "type": "string",
      "enum": [
        "save_story_artifact",
        "get_story_artifact",
        "list_story_artifacts",
        "read_story_artifact",
        "get_writing_context",
        "prepare_story_context"
      ]
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "inputFingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "localRef": {
      "$ref": "#/$defs/ref"
    },
    "remote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId"
      ],
      "properties": {
        "projectId": {
          "type": [
            "string",
            "null"
          ]
        },
        "artifactId": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "type": [
            "integer",
            "null"
          ]
        },
        "inputSnapshotId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "outcome": {
      "type": "string",
      "enum": [
        "confirmed",
        "rejected_conflict",
        "rejected_other",
        "unknown",
        "not_sent"
      ]
    },
    "retryAllowed": {
      "type": "boolean"
    },
    "observedAt": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string"
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Honest unknowns that no other field can express"
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "revision"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "remote_artifact",
            "remote_snapshot",
            "remote_brief",
            "local_file",
            "knowledge_card",
            "context_snapshot",
            "remote_receipt"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "range": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
