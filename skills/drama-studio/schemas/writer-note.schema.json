{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "drama-studio/writer-note/v0",
  "title": "人工批注记录：feedback-ingest 的统一入口（项目私有）",
  "description": "开放对象：未列出的字段允许（D6-0 的真实产物带运行注记，如 formatNotes）；禁止字段与跨字段规则由 contract-check 执行。",
  "type": "object",
  "required": [
    "noteId",
    "source",
    "humanNote",
    "level",
    "scope"
  ],
  "properties": {
    "schemaVersion": {
      "const": "drama-studio/writer-note/v0"
    },
    "noteId": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string"
    },
    "authorRole": {
      "type": "string",
      "enum": [
        "user",
        "writer",
        "advisor",
        "unknown"
      ],
      "description": "作者是谁：只有 user（用户本人）的决定类意见算已定；编剧、顾问给意见"
    },
    "date": {
      "type": "string"
    },
    "source": {
      "type": [
        "string",
        "object"
      ],
      "minLength": 1,
      "description": "「<kind>:<file>#<ref>」字符串，或 {kind, file, ref}"
    },
    "sourceKind": {
      "type": "string"
    },
    "episode": {
      "type": [
        "integer",
        "string"
      ],
      "description": "集号：整数，或拆集后的「6A」这类字符串"
    },
    "scene": {
      "type": "string"
    },
    "quotedText": {
      "type": "string"
    },
    "humanSuggestion": {
      "type": [
        "string",
        "null"
      ]
    },
    "humanNote": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "type": "string",
      "enum": [
        "line",
        "exchange",
        "topic",
        "scene_structure",
        "info_carrying",
        "addressee_convention",
        "monologue",
        "procedure",
        "fact",
        "decision",
        "unknown"
      ]
    },
    "attachesTo": {
      "type": "object"
    },
    "outcome": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "negative",
              "humanPositive",
              "conventionDraft",
              "questionDraft",
              "planTemplate",
              "ledgerProposal",
              "k1Draft",
              "decision"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "conflictsWith": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "object"
        ]
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "level"
      ],
      "properties": {
        "level": {
          "const": "project"
        },
        "projectId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Honest unknowns that no other field can express"
    },
    "formatNotes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "写的时候发现字段不够用、多余或有歧义时记一条"
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "revision"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "remote_artifact",
            "remote_page",
            "remote_snapshot",
            "remote_brief",
            "local_file",
            "knowledge_card",
            "context_snapshot",
            "remote_receipt"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "range": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
