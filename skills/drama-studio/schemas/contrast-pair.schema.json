{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "drama-studio/contrast-pair/v0",
  "title": "对照对：同一处境，正例这样走、我们那样走、为什么在这里不成立（项目私有）",
  "description": "开放对象：未列出的字段允许（D6-0 的真实产物带运行注记，如 formatNotes）；禁止字段与跨字段规则由 contract-check 执行。",
  "type": "object",
  "required": [
    "pairId",
    "positive",
    "negative",
    "whyNotHere",
    "provenance"
  ],
  "properties": {
    "schemaVersion": {
      "const": "drama-studio/contrast-pair/v0"
    },
    "pairId": {
      "type": "string",
      "minLength": 1
    },
    "situation": {
      "type": "object"
    },
    "positive": {
      "type": "object"
    },
    "negative": {
      "type": "object"
    },
    "whyNotHere": {
      "type": "string",
      "minLength": 1
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "negativeFrom"
      ],
      "properties": {
        "negativeFrom": {
          "type": "string",
          "minLength": 1
        },
        "humanNote": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "level"
      ],
      "properties": {
        "level": {
          "const": "project"
        },
        "projectId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Honest unknowns that no other field can express"
    },
    "formatNotes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "写的时候发现字段不够用、多余或有歧义时记一条"
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "revision"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "remote_artifact",
            "remote_page",
            "remote_snapshot",
            "remote_brief",
            "local_file",
            "knowledge_card",
            "context_snapshot",
            "remote_receipt"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "range": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
