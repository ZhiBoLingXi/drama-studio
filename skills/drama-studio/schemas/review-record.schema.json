{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "drama-studio/review-record/v0",
  "title": "对确定产物的审读记录",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reviewId",
    "target",
    "readingScope",
    "context",
    "firstReadWithoutAuthorNotes",
    "findings",
    "goalAssessments"
  ],
  "properties": {
    "schemaVersion": {
      "const": "drama-studio/review-record/v0"
    },
    "reviewId": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "$ref": "#/$defs/ref"
    },
    "additionalTargets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      },
      "description": "Optional: further reviewed artifacts when one review covers a batch; target stays the first one"
    },
    "readingScope": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      },
      "minItems": 1
    },
    "context": {
      "type": "string",
      "enum": [
        "independent",
        "serial_self_review",
        "human",
        "unknown"
      ]
    },
    "claimsIndependence": {
      "type": "boolean"
    },
    "firstReadWithoutAuthorNotes": {
      "type": "boolean"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "layer",
          "claim",
          "evidence",
          "severity"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": [
              "fact",
              "goal",
              "preference"
            ]
          },
          "layer": {
            "type": "string",
            "enum": [
              "C1",
              "C2",
              "C3",
              "C4",
              "C5",
              "C5a",
              "C5b",
              "C6"
            ],
            "description": "C5a (dialogue plan) or C5b (text) since D6-3; C5 stays for older records"
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ref",
                "quote"
              ],
              "properties": {
                "ref": {
                  "$ref": "#/$defs/ref"
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "severity": {
            "type": "string",
            "enum": [
              "block",
              "revise",
              "note"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "finding",
              "preference"
            ],
            "description": "Optional (D6): a finding without any cite is a preference and stays out of the revision list"
          },
          "cites": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "functionId": {
                "type": "string",
                "minLength": 1
              },
              "ledgerId": {
                "type": "string",
                "minLength": 1
              },
              "targetClause": {
                "type": "string",
                "minLength": 1
              },
              "factEvidence": {
                "type": "string",
                "minLength": 1
              }
            },
            "description": "Optional (D6): what the finding rests on; at least one of the four, otherwise kind: preference"
          }
        }
      }
    },
    "goalAssessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "goal",
          "status"
        ],
        "properties": {
          "goal": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "not_assessed",
              "met",
              "partially_met",
              "not_met",
              "insufficient_evidence"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "preserved": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "object"
        ],
        "minLength": 1,
        "required": [
          "item"
        ],
        "properties": {
          "item": {
            "type": "string",
            "minLength": 1
          },
          "noteId": {
            "type": "string",
            "minLength": 1
          },
          "humanWords": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "description": "What must survive a revision. D6-3: an object item names its human source (noteId of a writer-note, or the person's humanWords); season-check's dialogue layer accepts only such items. Plain strings are the pre-D6-3 form"
    },
    "losses": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Honest unknowns that no other field can express"
    },
    "adjudications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "findingIds",
          "decision",
          "reason"
        ],
        "properties": {
          "findingIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "decision": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "by": {
            "type": "string"
          }
        }
      },
      "description": "Optional (D6): how conflicting findings were settled; never carries replacement text"
    },
    "sealedSha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "D6-3: a first read's seal kept in the record itself: sha256 of the record's canonical JSON (sorted keys, no spaces, sealedSha256 left out); the .sha256 sidecar file still counts"
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "revision"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "remote_artifact",
            "remote_page",
            "remote_snapshot",
            "remote_brief",
            "local_file",
            "knowledge_card",
            "context_snapshot",
            "remote_receipt"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "range": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
