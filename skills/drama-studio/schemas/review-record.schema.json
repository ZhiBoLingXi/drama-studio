{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "drama-studio/review-record/v0",
  "title": "对确定产物的审读记录",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reviewId",
    "target",
    "readingScope",
    "context",
    "firstReadWithoutAuthorNotes",
    "findings",
    "goalAssessments"
  ],
  "properties": {
    "schemaVersion": {
      "const": "drama-studio/review-record/v0"
    },
    "reviewId": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "$ref": "#/$defs/ref"
    },
    "additionalTargets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      },
      "description": "Optional: further reviewed artifacts when one review covers a batch; target stays the first one"
    },
    "readingScope": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      },
      "minItems": 1
    },
    "context": {
      "type": "string",
      "enum": [
        "independent",
        "serial_self_review",
        "human",
        "unknown"
      ]
    },
    "claimsIndependence": {
      "type": "boolean"
    },
    "firstReadWithoutAuthorNotes": {
      "type": "boolean"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "layer",
          "claim",
          "evidence",
          "severity"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": [
              "fact",
              "goal",
              "preference"
            ]
          },
          "layer": {
            "type": "string",
            "enum": [
              "C1",
              "C2",
              "C3",
              "C4",
              "C5",
              "C6"
            ]
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ref",
                "quote"
              ],
              "properties": {
                "ref": {
                  "$ref": "#/$defs/ref"
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "severity": {
            "type": "string",
            "enum": [
              "block",
              "revise",
              "note"
            ]
          }
        }
      }
    },
    "goalAssessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "goal",
          "status"
        ],
        "properties": {
          "goal": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "not_assessed",
              "met",
              "partially_met",
              "not_met",
              "insufficient_evidence"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "preserved": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "losses": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Honest unknowns that no other field can express"
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "revision"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "remote_artifact",
            "remote_snapshot",
            "remote_brief",
            "local_file",
            "knowledge_card",
            "context_snapshot",
            "remote_receipt"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "range": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
