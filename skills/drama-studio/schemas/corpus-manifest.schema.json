{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "drama-studio/corpus-manifest/v0",
  "title": "语料清单：每集的快照、取用时间与统计",
  "description": "开放对象：未列出的字段允许（D6-0 的真实产物带运行注记，如 formatNotes）；禁止字段与跨字段规则由 contract-check 执行。 scope.level: studio 仅当 origin.kind == mali_story_template（计划 §8 #1，2026-10-15 确认）。",
  "type": "object",
  "required": [
    "episodes"
  ],
  "properties": {
    "schemaVersion": {
      "const": "drama-studio/corpus-manifest/v0"
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "episodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "templateId",
          "episodeIndex",
          "snapshotId",
          "fetchedAt"
        ],
        "properties": {
          "templateId": {
            "type": "string",
            "minLength": 1
          },
          "episodeIndex": {
            "type": "integer"
          },
          "snapshotId": {
            "type": [
              "string",
              "null"
            ]
          },
          "fetchedAt": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string"
          },
          "rawMdSha256": {
            "type": "string"
          }
        }
      },
      "minItems": 1
    },
    "series": {
      "type": "object"
    },
    "readCalls": {
      "type": "object"
    },
    "notUsed": {
      "type": "object"
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Honest unknowns that no other field can express"
    },
    "formatNotes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "写的时候发现字段不够用、多余或有歧义时记一条"
    },
    "scope": {
      "type": "object",
      "required": [
        "level"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "project",
            "studio"
          ]
        },
        "projectId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "origin": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "revision"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "remote_artifact",
            "remote_page",
            "remote_snapshot",
            "remote_brief",
            "local_file",
            "knowledge_card",
            "context_snapshot",
            "remote_receipt"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "range": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
