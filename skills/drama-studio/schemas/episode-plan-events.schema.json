{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "drama-studio/episode-plan-events/v0",
  "title": "分集计划的 events 导出（冷读包用）",
  "description": "由 plan-events 从分集计划导出：每场只留 sceneId、time、place、present、beats，每拍只留 beatId、who、text、quote、offscreen；saysFact、picture 等设计字段不在内。cold_reader 包对分集计划只收这份导出。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "episode",
    "source",
    "events"
  ],
  "properties": {
    "schemaVersion": {
      "const": "drama-studio/episode-plan-events/v0"
    },
    "episode": {
      "type": [
        "integer",
        "string"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "sha256"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenes"
      ],
      "properties": {
        "scenes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sceneId",
              "beats"
            ],
            "properties": {
              "sceneId": {
                "type": "string",
                "minLength": 1
              },
              "time": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "place": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "present": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "beats": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "beatId"
                  ],
                  "properties": {
                    "beatId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "who": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "text": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "quote": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "offscreen": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Honest unknowns that no other field can express"
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "revision"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "remote_artifact",
            "remote_page",
            "remote_snapshot",
            "remote_brief",
            "local_file",
            "knowledge_card",
            "context_snapshot",
            "remote_receipt"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "range": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
