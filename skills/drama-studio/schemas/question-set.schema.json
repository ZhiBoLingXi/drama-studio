{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "drama-studio/question-set/v0",
  "title": "版本化问题单（追问单、对话检查问题单共用）",
  "description": "项目可增问不可删；增问带来源（source）；drafted 问带 noteId。 开放对象：未列出的字段允许（D6-0 的真实产物带运行注记，如 formatNotes）；禁止字段与跨字段规则由 contract-check 执行。",
  "type": "object",
  "required": [
    "id",
    "version",
    "questions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "drama-studio/question-set/v0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "reality-check",
        "dialogue-check"
      ]
    },
    "examplesNote": {
      "type": "string"
    },
    "answerStates": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      },
      "minItems": 1
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Honest unknowns that no other field can express"
    },
    "formatNotes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "写的时候发现字段不够用、多余或有歧义时记一条"
    },
    "defectKinds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "D6-3: the defectKind words this question set uses; check-answers reports others (does not refuse)"
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "required": [
        "q",
        "text",
        "answerKind",
        "source",
        "addedIn"
      ],
      "properties": {
        "q": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "answerKind": {
          "type": "string",
          "enum": [
            "tristate",
            "informational"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "addedIn": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "confirmed",
            "drafted"
          ]
        },
        "noteId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "revision"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "remote_artifact",
            "remote_page",
            "remote_snapshot",
            "remote_brief",
            "local_file",
            "knowledge_card",
            "context_snapshot",
            "remote_receipt"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "range": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
