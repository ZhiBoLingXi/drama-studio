{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "drama-studio/dialogue-target/v0",
  "title": "台词目标（项目级、版本化）",
  "description": "没有 acceptedBand／hardRules／softRules；约定条目须带来源 note。 开放对象：未列出的字段允许（D6-0 的真实产物带运行注记，如 formatNotes）；禁止字段与跨字段规则由 contract-check 执行。",
  "type": "object",
  "required": [
    "targetId",
    "revision",
    "conventions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "drama-studio/dialogue-target/v0"
    },
    "targetId": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "drafted",
        "confirmed"
      ]
    },
    "mediaProfile": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "description": "The project media profile; null means the bundled data/default-media-profile.json, as capacity uses it (D6-3 walkthrough #17)"
    },
    "corpusManifest": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "description": "The corpus manifest the target leans on; null when the project has no corpus yet, then noCorpusReason says why (D6-3 walkthrough #2)"
    },
    "checkQuestions": {
      "type": "string",
      "minLength": 1
    },
    "conventions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "status",
          "sourceNotes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "confirmed",
              "drafted"
            ]
          },
          "sourceNotes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "conflictsWith": {
            "type": "array",
            "items": {
              "type": [
                "object",
                "string"
              ]
            }
          }
        }
      }
    },
    "infoCarriageDefault": {
      "type": "string",
      "enum": [
        "dialogue",
        "picture"
      ]
    },
    "changelog": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Honest unknowns that no other field can express"
    },
    "formatNotes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "写的时候发现字段不够用、多余或有歧义时记一条"
    },
    "noCorpusReason": {
      "type": "string",
      "minLength": 1,
      "description": "Required when corpusManifest is null"
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "revision"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "remote_artifact",
            "remote_page",
            "remote_snapshot",
            "remote_brief",
            "local_file",
            "knowledge_card",
            "context_snapshot",
            "remote_receipt"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "range": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
