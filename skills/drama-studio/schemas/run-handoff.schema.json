{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "drama-studio/run-handoff/v0",
  "title": "一次工位运行的交接",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "taskId",
    "workstation",
    "methodVersion",
    "contextSnapshotId",
    "host",
    "outputs",
    "stateChangeProposals",
    "changeProposals",
    "status",
    "unfinished",
    "nextAction"
  ],
  "properties": {
    "schemaVersion": {
      "const": "drama-studio/run-handoff/v0"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "workstation": {
      "type": "string",
      "enum": [
        "C1",
        "C2",
        "C3",
        "C4",
        "C5",
        "C6"
      ]
    },
    "methodVersion": {
      "type": "string",
      "minLength": 1
    },
    "contextSnapshotId": {
      "type": "string",
      "minLength": 1
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "usage"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "type": "string",
              "enum": [
                "host_reported",
                "estimated",
                "unknown"
              ]
            },
            "calls": {
              "type": "integer",
              "minimum": 0
            },
            "chars": {
              "type": "integer",
              "minimum": 0
            },
            "tokens": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "stateChangeProposals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim",
          "evidence"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "$ref": "#/$defs/ref"
          }
        }
      }
    },
    "changeProposals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "targetLayer",
          "problem",
          "evidence",
          "proposedChange",
          "unknownScope",
          "needsDecision"
        ],
        "properties": {
          "targetLayer": {
            "type": "string",
            "enum": [
              "C1",
              "C2",
              "C3",
              "C4",
              "C5",
              "C6"
            ]
          },
          "problem": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "$ref": "#/$defs/ref"
          },
          "proposedChange": {
            "type": "string",
            "minLength": 1
          },
          "affected": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ref"
            }
          },
          "unknownScope": {
            "type": "string"
          },
          "protectedLosses": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "needsDecision": {
            "type": "boolean"
          }
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run",
        "goal"
      ],
      "properties": {
        "run": {
          "type": "string",
          "enum": [
            "planned",
            "running",
            "interrupted",
            "finished",
            "failed"
          ]
        },
        "goal": {
          "type": "string",
          "enum": [
            "not_assessed",
            "met",
            "partially_met",
            "not_met",
            "insufficient_evidence"
          ]
        }
      }
    },
    "unfinished": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nextAction": {
      "type": "string",
      "minLength": 1
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Honest unknowns that no other field can express"
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "revision"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "remote_artifact",
            "remote_snapshot",
            "remote_brief",
            "local_file",
            "knowledge_card",
            "context_snapshot",
            "remote_receipt"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "range": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
